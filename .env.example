# Токен бота от @BotFather
BOT_TOKEN=
# Ссылка на Google Таблицу (нужен доступ «Все, у кого есть ссылка → Читатель») или путь к .xlsx
CATALOG=https://docs.google.com/spreadsheets/d/1jW3sHsxgwMMbmZcgJCpjYZiYiqKJciXgYDNbiYMf79k/edit
# Telegram id людей, которым можно пользоваться ботом и получать уведомления, через запятую.
# Свой id покажет сам бот, если написать ему /start, пока ты не в списке. Пусто = бот доступен всем, уведомлений нет.
ALLOWED_USERS=
DB_PATH=avito.sqlite3
